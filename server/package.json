{
  "name": "@goathub/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "livekit-server-sdk": "^2.19.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
